{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "isolatedModules": false,
        "jsx": "react-jsx",
        "module": "commonjs",
        "moduleResolution": "node",
        "noEmit": false,
        "outDir": ".test-dist",
        "rootDir": "src",
        "target": "es2020",
        "types": ["node"]
    },
    "include": [
        "src/utils/media.ts",
        "src/utils/media.test.ts",
        "src/utils/youtube.ts",
        "src/utils/youtube.test.ts",
        "src/domain/game/round.ts",
        "src/domain/game/round.test.ts",
        "src/domain/game/clear.ts",
        "src/domain/game/clear.test.ts",
        "src/domain/manage/content.ts",
        "src/domain/manage/content.test.ts",
        "src/domain/manage/persistedContent.ts",
        "src/domain/manage/persistedContent.test.ts"
    ],
    "exclude": []
}
